# Redmi Note 9 Pro / Note 9S / Poco M2 Pro (joyeuse, SM7125) -- Linux 4.14.117.
#
# Run it with:  Actions -> Build Kernel -> Config file to build =
#               config/joyeuse.env
#
# Everything below is derived from the tree itself, not guessed:
#   arch/arm64/configs/custj_defconfig
#     CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE is not set -> Image.gz, not Image.gz-dtb
#     CONFIG_BUILD_ARM64_DT_OVERLAY=y                  -> a separate dtbo.img is built
#     CONFIG_KPROBES is not set                        -> manual hooks, see below
#     CONFIG_KALLSYMS_ALL=y, CONFIG_DEBUG_KERNEL=y     -> ReSukiSU's non-GKI
#                                                         export check is satisfied
#     CONFIG_OVERLAY_FS=y, CONFIG_TMPFS_XATTR=y        -> module mounting works

CONFIG_ENV=config/joyeuse.env

# ============================================================ Kernel source ==

KERNEL_SOURCE=https://github.com/Kirid2005/kernel_joyeuse
KERNEL_SOURCE_BRANCH=master
KERNEL_CONFIG=custj_defconfig
KERNEL_IMAGE_NAME=Image.gz
ARCH=arm64

# The defconfig is named custj_defconfig, so the derived device label would be
# "custj". Name it after the codename instead, which is what the flashable zip
# and the artifacts end up called.
KERNEL_NAME=joyeuse
ADD_LOCALVERSION_TO_FILENAME=false

# The tree's own build.sh uses proton-clang with CLANG_TRIPLE and the Android
# GCC binutils; ld.lld replaces the GNU linker, which chokes on this tree.
EXTRA_CMDS:LD=ld.lld
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# =================================================================== Clang ==
#
# 4.x trees do not build reliably with a current AOSP clang (dropped flags,
# stricter warnings). r450784e is the pair verified for 4.9-4.19.
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
USE_LLVM=false

# ===================================================================== GCC ==
#
# Needed as binutils: 4.14 predates reliable use of LLVM's integrated
# assembler, and the tree still builds a 32-bit vDSO.
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true

# =============================================================== KernelSU ===
#
# ReSukiSU is a re-fork of SukiSU-Ultra aimed at exactly this case: legacy
# non-GKI kernels, with multi-manager support. Alternatives if it misbehaves:
#   KSU_VARIANT=kernelsu       KSU_REF=v0.9.5  (last upstream with non-GKI)
#   KSU_VARIANT=sukisu-ultra   KSU_REF=builtin (needed if you want SUSFS)
#
# KSU_REF is left blank on purpose: for a pre-GKI kernel the action resolves it
# to ReSukiSU's 'main'. Pin a tag here once a build works if you want the
# manager version to stay reproducible across runs.
KSU_VARIANT=resukisu
KSU_REF=

# CONFIG_KPROBES is off in custj_defconfig and kprobes on pre-GKI kernels is the
# classic "KernelSU installs but su does nothing" failure. Manual hooks are
# patched straight into the syscall entry points instead.
KSU_HOOK_MODE=manual

KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==
#
# Off deliberately. susfs4ksu's kernel-4.14 branch has not been touched since
# early 2025 and targets KernelSU's old flat source layout, so its KernelSU-side
# patch does not apply to ReSukiSU. To get root hiding on this device, switch to
# KSU_VARIANT=sukisu-ultra with KSU_REF=builtin, which ships SUSFS itself, and
# set ENABLE_SUSFS=true.
ENABLE_SUSFS=false
SUSFS_BRANCH=auto

# ========================================================== Extra patches ===

# path_umount() arrived in 5.9; 4.14 needs the backport for KernelSU to unmount
# its own overlays before a root check runs.
ENABLE_PATH_UMOUNT=true
ENABLE_HIDE_STUFF=false

# KPM is SukiSU-Ultra only.
ENABLE_KPM=false

# ================================================================ Kconfig ===

ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=false
# Old tree, newer clang: keep warnings visible but non-fatal.
DISABLE_CC_WERROR=true
EXTRA_DEFCONFIG=

# ============================================================= AnyKernel3 ===

USE_CUSTOM_ANYKERNEL3=false

# ============================================================== Packaging ===

# CONFIG_BUILD_ARM64_DT_OVERLAY=y -- joyeuse has its own dtbo partition, and the
# flashable zip must carry dtbo.img alongside the kernel.
NEED_DTBO=true

BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# ================================================================= Runner ===

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
